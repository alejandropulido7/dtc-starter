# ==============================================================================
# Medusa DTC Starter - Dokploy Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=production

# Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters
COOKIE_SECRET=super_secret_cookie_key_at_least_32_characters

# Database Credentials
POSTGRES_USER=medusa
POSTGRES_PASSWORD=super_secure_postgres_password
POSTGRES_DB=medusa_backend

# URLs & CORS (Replace with your actual domains, NO trailing slashes)
MEDUSA_BACKEND_URL=https://api.yourdomain.com
STORE_URL=https://yourstore.com
STORE_CORS=https://yourstore.com,https://your-store.vercel.app
ADMIN_CORS=https://api.yourdomain.com
AUTH_CORS=https://api.yourdomain.com,https://yourstore.com,https://your-store.vercel.app

# Storefront Settings
# Retrieve this key from Medusa Admin -> Settings -> Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_your_key_from_admin
NEXT_PUBLIC_DEFAULT_REGION=us
